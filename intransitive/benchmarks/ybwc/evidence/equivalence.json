  "plan": {
    "acceptance": {
      "null_outcome": "Keeping the feature implemented and disabled is a valid result.",
      "primary": "Equal-time paired play against the same engine at one thread. Adopt (default on) only if the decisive win rate at four threads has a 95% Wilson lower bound above 0.5.",
      "secondary": "Node throughput is reported for diagnosis only and can never carry the decision."
    },
    "baseline_revision": "8d22a1117f9fcb4fdc89057f13c5f48255ad5c26",
    "equivalence": {
      "determinism": "At each of threads 2, 3 and 4, repeated runs of the same request must agree on action, score, principal variation and node count. Determinism is claimed per thread count, not across thread counts, and not for a search that runs out of time.",
      "rule": "At threads = 1 the new binary must reproduce the frozen baseline's action, score, principal variation, completed depth, node count and stop reason exactly, on every recorded row."
    },
    "fixed_depth": {
      "depths": [
        4,
