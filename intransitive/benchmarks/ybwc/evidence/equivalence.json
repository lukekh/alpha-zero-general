      ]
    },
    "hardware_note": "Measured on 4 performance + 4 efficiency cores. Thread counts above 4 are not measured and are not claimed.",
    "issue": 65,
    "not_measured": [
      "Shared transposition tables. Measuring them would mean shipping a nondeterministic search path, which the determinism constraint rules out before any measurement.",
      "Thread counts above the machine's performance-core count.",
      "Parallel proof or certificate search. Those paths stay sequential by construction."
    ],
    "paired_protocol": {
      "colours": "both",
      "max_plies": 100,
      "mode": "wall",
      "note": "Both engines are deterministic, so a start played twice from the same colour is the same game. The sample size is the number of distinct starts, not a number of repeats.",
      "seconds_per_move": 0.5,
      "starts": "official start plus the first eight opening, midgame and endgame starts by state hash: 25 starts, 50 games per thread count",
      "thread_counts": [
        2,
        4
      ],
      "unfinished": "counted as unresolved and worth zero, as in #54; the decisive interval uses wins and losses only"
    },
    "positions": {
      "equivalence_and_overhead": "official start plus the first two opening, midgame and endgame starts by state hash",
      "paired": "official start plus the first eight opening, midgame and endgame starts by state hash, each played from both colours",
      "reason": "The #54 harness cannot run a native candidate: tournament.spec.candidate() rejects every backend but python. Its position generator, stage definitions, both-colour pairing and Wilson reporting are reused here against the native engine instead.",
      "source": "intransitive.tournament.spec.generate_positions(seed=65, lines=9)"
    },
