      {"id": "teacher-self-0", "seed": 0, "players": ["teacher", "teacher"]},
      {"id": "teacher-random-1", "seed": 1, "players": ["teacher", "random"]},
      {"id": "random-teacher-2", "seed": 2, "players": ["random", "teacher"]},
      {"id": "teacher-greedy-3", "seed": 3, "players": ["teacher", "greedy"]},
      {"id": "greedy-teacher-4", "seed": 4, "players": ["greedy", "teacher"]},
      {"id": "teacher-random-5", "seed": 5, "players": ["teacher", "random"]},
      {"id": "random-teacher-6", "seed": 6, "players": ["random", "teacher"]},
      {"id": "teacher-greedy-7", "seed": 7, "players": ["teacher", "greedy"]},
      {"id": "greedy-teacher-8", "seed": 8, "players": ["greedy", "teacher"]}
    ]
  },
  "training": {
    "seeds": [410, 411, 412],
    "updates_per_phase": 4,
    "anneal_teacher_fractions": [0.5, 0.25],
