  "self_play": {
    "games_per_phase": 1,
    "root_noise": -1.0,
    "settings": {
      "numMCTSSims": 4,
      "prob_fullMCTS": 1.0,
      "ratio_fullMCTS": 1,
      "forced_playouts": false,
      "universes": 0,
      "cpuct": 1.25,
      "fpu": 0.0,
      "no_mem_optim": false,
      "parallel_inferences": 1,
      "temperature": [1.0, 1.0, 1.0],
      "tempThreshold": 10,
      "maxlenOfQueue": 7200,
      "numIters": 1,
      "numItersHistory": 1,
      "profile": false,
      "arenaCompare": 2,
      "updateThreshold": 0.6,
      "stop_after_N_fail": 1,
      "useray": false
