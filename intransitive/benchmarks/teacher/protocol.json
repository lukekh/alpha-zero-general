  "evaluation": {
    "opponents": ["random", "greedy", "frozen_neural", "alpha_beta"],
    "search_assisted_opponents": ["greedy", "alpha_beta"],
    "games_per_agent_opponent_seed": 2,
    "mcts_simulations": 4,
    "tactical_cases": 100,
    "physical_first_player": "Blue"
  },
  "budgets": {
    "training_seeds": 3,
    "teacher_trajectories": 9,
    "optimizer_updates_pretrain": 4,
    "optimizer_updates_continuation": 8,
