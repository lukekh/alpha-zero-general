{
  "schema": "intransitive-teacher-protocol-1",
  "purpose": "Issue #33/#35 bounded teacher-learning and exploration pilot",
  "teacher": {
    "search": {
      "evaluator_version": "intransitive-heuristics-v2",
      "count_weight": 100.0,
      "race_weight": 0.0,
      "advantage_weight": 25.0,
      "attack_weight": 12.0,
      "defence_weight": 10.0,
      "overload_weight": 5.0,
      "predator_zero_bonus": 1.0,
      "predator_scarcity_bonus": 0.5,
      "prey_bonus": 0.25,
      "attack_enabled": false,
      "defence_enabled": false,
      "overload_enabled": false,
      "max_depth": 1,
      "node_limit": 500000,
      "time_limit": 60.0,
      "proof_depth": 2,
      "proof_nodes": 64,
      "table_entries": 10000
